{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sce-filter metadata predicates v1",
  "description": "Runtime additionally enforces 1048576 bytes, 32 predicate levels, 10000 total nodes, unique keys, finite numbers and metadata types.",
  "type": "object",
  "required": [
    "rowdata",
    "coldata"
  ],
  "additionalProperties": false,
  "properties": {
    "rowdata": {
      "$ref": "#/$defs/section"
    },
    "coldata": {
      "$ref": "#/$defs/section"
    }
  },
  "$defs": {
    "section": {
      "oneOf": [
        {
          "type": "object",
          "maxProperties": 0
        },
        {
          "$ref": "#/$defs/node"
        }
      ]
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "enum": [
                "gt",
                "ge",
                "lt",
                "le",
                "eq",
                "ne"
              ]
            },
            "value": {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            }
          },
          "required": [
            "field",
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "enum": [
                "in"
              ]
            },
            "value": {
              "oneOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "number"
                  }
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "boolean"
                  }
                }
              ]
            }
          },
          "required": [
            "field",
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "enum": [
                "is_missing"
              ]
            }
          },
          "required": [
            "field",
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/node"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
